# Required
MODEL_API_KEY=your_meta_api_key_here

# Optional — path to the SQLite invoice database
# VOIZGGER_DB=voizgger.db

# Optional — cost guards for a public deployment (on by default)
# DEMO_DAILY_LIMIT=50     # AI calls allowed per day, across all visitors
# DEMO_IP_LIMIT=5         # AI requests per IP...
# DEMO_IP_WINDOW=60       # ...within this many seconds
# DEMO_LIMITS_ENABLED=0   # switch both guards off for local development
